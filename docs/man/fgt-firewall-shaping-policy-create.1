.TH "FGT" "1" "Sep 2026" "fgt" "fgt Manual"

.SH NAME
fgt-firewall-shaping-policy-create - Create a shaping-policy object


.SH SYNOPSIS
\fBfgt firewall shaping-policy create [id] [flags]\fP


.SH DESCRIPTION
Create a shaping-policy object


.SH OPTIONS
\fB--dstaddr\fP=""
	destination address(es), comma-separated

.PP
\fB--dstintf\fP=""
	destination interface(s)/zone(s), comma-separated

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--per-ip-shaper\fP=""
	per-IP traffic shaper name

.PP
\fB--service\fP=""
	service(s), comma-separated

.PP
\fB--set\fP=[]
	set an arbitrary field: --set key=value (repeatable; value may be a,b for ref lists)

.PP
\fB--srcaddr\fP=""
	source address(es), comma-separated

.PP
\fB--srcintf\fP=""
	source interface(s)/zone(s), comma-separated

.PP
\fB--status\fP=""
	enable|disable

.PP
\fB--traffic-shaper\fP=""
	forward traffic shaper name

.PP
\fB--traffic-shaper-reverse\fP=""
	reverse traffic shaper name



.nh
.TH "FGT" "1" "Sep 2026" "fgt" "fgt Manual"

.SH NAME
fgt-vpn-certificate-local-import - Import a local certificate (PEM cert+key or PKCS12) — privileged upload


.SH SYNOPSIS
\fBfgt vpn certificate local import  [flags]\fP


.SH DESCRIPTION
Import a device certificate. Provide either --cert (PEM, or - for stdin)
plus --key (PEM), or --pkcs12 (a .p12/.pfx bundle) with its passphrase via
--password-file/--password-env. Secrets are never passed as flag values.


.SH OPTIONS
\fB--cert\fP=""
	PEM certificate file (or - for stdin)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB--key\fP=""
	PEM private-key file

.PP
\fB--password-env\fP=""
	env var holding the PKCS12/key passphrase

.PP
\fB--password-file\fP=""
	file holding the PKCS12/key passphrase

.PP
\fB--pkcs12\fP=""
	PKCS12/PFX bundle file

.PP
\fB--scope\fP="vdom"
	import scope: vdom|global


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--column\fP=[]
	select/order output columns (repeatable)

.PP
\fB--context\fP=""
	config context to use

.PP
\fB--debug\fP[=false]
	log request/response metadata to stderr

.PP
\fB-o\fP, \fB--format\fP=""
	output format: table|json|yaml|csv|value

.PP
\fB--global\fP[=false]
	target the global scope (multi-VDOM) instead of a VDOM

.PP
\fB--insecure\fP[=false]
	skip TLS verification (footgun)

.PP
\fB--no-headers\fP[=false]
	omit table/csv headers

.PP
\fB--password\fP=""
	admin password for session auth (prefer a secret_ref or FGT_CLI_PASSWORD)

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--server\fP=""
	FortiGate API base URL (e.g. https://fw.example.com)

.PP
\fB--sort\fP=""
	sort by column (NAME[:asc|desc])

.PP
\fB--tls-fingerprint\fP=""
	pin the server cert SHA-256 fingerprint

.PP
\fB--token\fP=""
	REST API token (prefer a config secret_ref or FGT_CLI_TOKEN)

.PP
\fB--user\fP=""
	admin username for session auth (or FGT_CLI_USER)

.PP
\fB--vdom\fP=""
	target VDOM (default: device global/root)

.PP
\fB--wide\fP[=false]
	do not truncate wide table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	assume yes for destructive confirmations


.SH SEE ALSO
\fBfgt-vpn-certificate-local(1)\fP

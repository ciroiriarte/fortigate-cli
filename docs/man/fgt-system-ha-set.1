.nh
.TH "FGT" "1" "Sep 2026" "fgt" "fgt Manual"

.SH NAME
fgt-system-ha-set - Update fields on a ha object


.SH SYNOPSIS
\fBfgt system ha set [flags]\fP


.SH DESCRIPTION
Update fields on a ha object


.SH OPTIONS
\fB--group-id\fP=""
	cluster group id 0-1023

.PP
\fB--group-name\fP=""
	cluster group name

.PP
\fB--hbdev\fP=""
	heartbeat interfaces, e.g. "port3 50"

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--mode\fP=""
	standalone|a-a|a-p

.PP
\fB--override\fP=""
	enable|disable

.PP
\fB--password\fP=""
	cluster password

.PP
\fB--priority\fP=""
	device priority (higher wins)

.PP
\fB--session-pickup\fP=""
	enable|disable

.PP
\fB--set\fP=[]
	set an arbitrary field: --set key=value (repeatable; value may be a,b for ref lists)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--column\fP=[]
	select/order output columns (repeatable)

.PP
\fB--context\fP=""
	config context to use

.PP
\fB--debug\fP[=false]
	log request/response metadata to stderr

.PP
\fB-o\fP, \fB--format\fP=""
	output format: table|json|yaml|csv|value

.PP
\fB--insecure\fP[=false]
	skip TLS verification (footgun)

.PP
\fB--no-headers\fP[=false]
	omit table/csv headers

.PP
\fB--profile\fP=""
	config profile to use

.PP
\fB--server\fP=""
	FortiGate API base URL (e.g. https://fw.example.com)

.PP
\fB--sort\fP=""
	sort by column (NAME[:asc|desc])

.PP
\fB--tls-fingerprint\fP=""
	pin the server cert SHA-256 fingerprint

.PP
\fB--token\fP=""
	REST API token (prefer a config secret_ref or FGT_CLI_TOKEN)

.PP
\fB--user\fP=""
	admin username for session auth (or FGT_CLI_USER)

.PP
\fB--vdom\fP=""
	target VDOM (default: device global/root)

.PP
\fB--wide\fP[=false]
	do not truncate wide table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	assume yes for destructive confirmations


.SH SEE ALSO
\fBfgt-system-ha(1)\fP
